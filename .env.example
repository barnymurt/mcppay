# Rail selection
PAYMENT_RAIL=sandbox          # sandbox | stripe | gerorail | bank | auto

# Auth
API_KEY_SALT=random-32-char-salt-for-hashing
JWT_SECRET=change-me
JWT_EXPIRY=900

# Stripe (fiat fallback)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# GERO / Cardano
BLOCKFROST_PROJECT_ID=...      # For Cardano mainnet
BLOCKFROST_PREPROD_PROJECT_ID=...  # For Cardano preprod
GERO_CONTRACT_ADDRESS=...      # GERO token policy ID on Cardano
GERO_POLL_INTERVAL_MS=30000
GERO_CONFIRMATIONS=1

# Bank Adapter (Sachel Bank)
BANK_API_URL=https://api.sachelbank.example
BANK_API_KEY=...
BANK_WEBHOOK_SECRET=...

# Ledger
LEDGER_DB_PATH=./data/ledger.db

# Server
MCP_SERVER_PORT=3100
API_PORT=3101

# Observability
LOG_LEVEL=info
LOG_FORMAT=pretty

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
